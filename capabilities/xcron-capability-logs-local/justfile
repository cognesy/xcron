set positional-arguments := true

ROOT := parent_directory(parent_directory(justfile_directory()))

default:
    @just --list

list:
    @just --list

doctor:
    @uv run --project {{ROOT}} python -c "from xcron.capabilities.logs_local.provider import CAPABILITY; assert CAPABILITY.id == 'logs:local'"

check:
    @uv run --project {{ROOT}} pytest {{ROOT}}/capabilities/xcron-capability-logs-local/tests -q

test:
    @uv run --project {{ROOT}} pytest {{ROOT}}/capabilities/xcron-capability-logs-local/tests -q

build:
    @uv build --project {{ROOT}} --package xcron-capability-logs-local --out-dir /tmp/xcron-logs-local-build --clear
