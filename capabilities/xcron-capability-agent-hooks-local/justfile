set positional-arguments := true

ROOT := parent_directory(parent_directory(justfile_directory()))

default:
    @just --list

list:
    @just --list

doctor:
    @uv run --project {{ROOT}} python -c "from xcron.capabilities.agent_hooks_local.provider import CAPABILITY; assert CAPABILITY.id == 'agent-hooks:local'"

check:
    @uv run --project {{ROOT}} pytest {{ROOT}}/capabilities/xcron-capability-agent-hooks-local/tests -q

test:
    @uv run --project {{ROOT}} pytest {{ROOT}}/capabilities/xcron-capability-agent-hooks-local/tests -q

build:
    @uv build --project {{ROOT}} --package xcron-capability-agent-hooks-local --out-dir /tmp/xcron-agent-hooks-local-build --clear
