set positional-arguments := true

ROOT := parent_directory(parent_directory(justfile_directory()))

default:
    @just --list

list:
    @just --list

doctor:
    @uv run --project {{ROOT}} python -c "from xcron.capabilities.observability_structlog.provider import CAPABILITY; assert CAPABILITY.id == 'observability:structlog'"

check:
    @uv run --project {{ROOT}} pytest {{ROOT}}/capabilities/xcron-capability-observability-structlog/tests -q

test:
    @uv run --project {{ROOT}} pytest {{ROOT}}/capabilities/xcron-capability-observability-structlog/tests -q

build:
    @uv build --project {{ROOT}} --package xcron-capability-observability-structlog --out-dir /tmp/xcron-observability-structlog-build --clear
